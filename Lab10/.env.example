# Copy to .env and adjust. .env is ignored by git and docker (.gitignore, .dockerignore).
APP_NAME=Bank Account Service
APP_ENV=development
DATABASE_URL=sqlite:///bank.db
LOG_LEVEL=INFO
# Secret for admin endpoints (X-API-Key header). Generate, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
HOST=127.0.0.1
PORT=8000
